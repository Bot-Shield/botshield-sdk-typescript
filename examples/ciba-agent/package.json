{
  "name": "botshield-ciba-agent-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenID CIBA with BotShield: a plain Node script and a Claude Agent SDK agent",
  "scripts": {
    "plain": "tsx --conditions=botshield-sdk/source plain.ts",
    "agent": "tsx --conditions=botshield-sdk/source agent.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "botshield-sdk": "file:../..",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
