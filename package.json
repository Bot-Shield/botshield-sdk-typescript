{
  "name": "botshield-sdk",
  "version": "1.9.0",
  "author": "BotShield",
  "type": "module",
  "bin": {
    "mcp": "bin/mcp-server.js"
  },
  "tshy": {
    "compiler": "tsgo",
    "sourceDialects": [
      "botshield-sdk/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models/errors": "./src/models/errors/index.ts",
      "./models": "./src/models/index.ts",
      "./models/operations": "./src/models/operations/index.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint --max-warnings=0 --deny-warnings src/**/*.ts src/**/*.tsx",
    "build:mcp": "bun src/mcp-server/build.mts",
    "build": "npm run build:mcp && tshy",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    
  },
  "devDependencies": {
    "@stricli/core": "^1.1.1",
    "@types/express": "^4.17.21",
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "bun": "1.2.17",
    "bun-types": "1.2.17",
    "express": "^4.21.2",
    "oxlint": "^1.60.0",
    "tshy": "^3.3.2",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
